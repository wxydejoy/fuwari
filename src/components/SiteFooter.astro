---
/**
 * 全站暗色页脚（首页 / 守岸人专栏共用），信息结构与博客 Footer.astro 对齐。
 *
 * - compact:单行小字,嵌在首页封面底部
 * - 完整模式:多行居中块,用于专栏页
 * 样式见 public/landing/style.css 的 .dk-footer 体系。
 */
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
import packageJson from "../../package.json" with { type: "json" };

interface Props {
	compact?: boolean;
	class?: string;
}

const { compact = false, className } = Astro.props;
const currentYear = new Date().getFullYear();
const version = packageJson.version;
---

{
	compact ? (
		<div class:list={["dk-footer", "dk-footer--compact", className]}>
			<span>© {currentYear} {profileConfig.name}</span>
			<a href={url("rss.xml")} target="_blank" rel="noreferrer">
				RSS
			</a>
			<a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
				浙ICP备2021022005号
			</a>
		</div>
	) : (
		<div class:list={["dk-footer", "dk-footer--full", className]}>
			<div class="dk-footer-line">
				© {currentYear} {profileConfig.name}. All Rights Reserved. /
				<a href={url("rss.xml")} target="_blank" rel="noreferrer">
					RSS
				</a>
				/
				<a href={url("sitemap-index.xml")} target="_blank" rel="noreferrer">
					Sitemap
				</a>
			</div>
			<div class="dk-footer-line">
				<a
					href="https://beian.mps.gov.cn/#/query/webSearch?code=33011302001366"
					target="_blank"
					rel="noreferrer"
					class="dk-footer-beian"
				>
					<img src="/beian-gongan.png" alt="" width="16" height="16" loading="lazy" />
					浙公网安备33011302001366号
				</a>
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
					浙ICP备2021022005号
				</a>
			</div>
			<div class="dk-footer-line">
				Powered by <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a> &
				<a href="https://github.com/saicaca/fuwari" target="_blank" rel="noreferrer">Fuwari</a>
				·
				<a
					class="dk-footer-flavor"
					href="https://baike.baidu.com/item/%E5%AE%88%E5%B2%B8%E4%BA%BA/64754105"
					target="_blank"
					rel="noreferrer">
					守岸人
				</a>
				For
				<a
					class="dk-footer-flavor"
					href="https://baike.baidu.com/item/%E6%BC%82%E6%B3%8A%E8%80%85/61295829"
					target="_blank"
					rel="noreferrer">
					漂泊者
				</a>
				· <span class="dk-footer-version">Version {version}</span>
			</div>
		</div>
	)
}
