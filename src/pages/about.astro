---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content, headings } = await render(aboutPost);

const dateHeading = /^\d{4}-\d{2}-\d{2}$/;
const headingText = (text: string) => text.replace(/#$/, "").trim();
let inDatedChangelog = false;
const tocHeadings = headings.filter((heading) => {
	if (heading.depth === 2) {
		inDatedChangelog = dateHeading.test(headingText(heading.text));
		return true;
	}
	return heading.depth === 3 && !inDatedChangelog;
});
---
<MainGridLayout title={i18n(I18nKey.about)} headings={tocHeadings}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2 onload-animation">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>