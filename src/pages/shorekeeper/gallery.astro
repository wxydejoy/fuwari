---
import SiteNav from "../../components/SiteNav.astro";
import SkLayout from "../../layouts/SkLayout.astro";
import { columnNav, featureShots, galleryCats, galleryPool } from "../../data/shorekeeper";
---

<SkLayout title="画廊 - 守岸人专栏">
  <main class="sk-page">
    <SiteNav current={Astro.url.pathname} links={columnNav} class="dk-load" />

    <header class="sk-page-head">
      <h1 class="sk-section-title">画廊</h1>
    </header>

    <div class="sk-content">
      <section class="sk-section is-wide dk-reveal">
        <h3 class="sk-sub-title">主视觉</h3>
        <div class="sk-feature-grid">
          <div class="sk-feature-col">
            {featureShots.slice(1, 2).map((shot) => (
              <figure class="sk-shot-card is-landscape">
                <button class="sk-shot-btn" type="button" data-lb={shot.src} data-lb-caption={`${shot.title} · ${shot.desc}`}>
                  <img
                    src={shot.src}
                    width={shot.width}
                    height={shot.height}
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
                <figcaption>
                  <strong>{shot.title}</strong>
                  {shot.desc}
                </figcaption>
              </figure>
            ))}
            <figure class="sk-shot-card is-portrait">
              <button class="sk-shot-btn" type="button" data-lb={featureShots[0].src} data-lb-caption={`${featureShots[0].title} · ${featureShots[0].desc}`}>
                <img
                  src={featureShots[0].src}
                  width={featureShots[0].width}
                  height={featureShots[0].height}
                  alt={featureShots[0].alt}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption>
                <strong>{featureShots[0].title}</strong>
                {featureShots[0].desc}
              </figcaption>
            </figure>
          </div>
          <figure class="sk-shot-card is-full">
            <button class="sk-shot-btn" type="button" data-lb={featureShots[2].src} data-lb-caption={`${featureShots[2].title} · ${featureShots[2].desc}`}>
              <img
                src={featureShots[2].src}
                width={featureShots[2].width}
                height={featureShots[2].height}
                alt={featureShots[2].alt}
                loading="lazy"
                decoding="async"
              />
            </button>
            <figcaption>
              <strong>{featureShots[2].title}</strong>
              {featureShots[2].desc}
            </figcaption>
          </figure>
        </div>

        <h3 class="sk-sub-title">图库</h3>
        <div class="sk-filter" role="group" aria-label="图库筛选">
          <button type="button" class="sk-chip is-active" data-filter="all">全部</button>
          {galleryCats.map((cat) => (
            <button type="button" class="sk-chip" data-filter={cat.id}>{cat.label}</button>
          ))}
        </div>
        <div class="sk-masonry" id="sk-pool">
          {galleryPool.map((shot) => (
            <figure class="sk-shot-card" data-cat={shot.cat}>
              <button
                class="sk-shot-btn"
                type="button"
                data-lb={shot.src}
                data-lb-caption={shot.desc ? `${shot.title} · ${shot.desc}` : shot.title}
              >
                <img
                  src={shot.src}
                  width={shot.width}
                  height={shot.height}
                  alt={shot.alt}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption>
                <strong>{shot.title}</strong>
                {shot.desc && <span>{shot.desc}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    </div>
  </main>

  <div class="sk-lightbox" id="sk-lightbox" role="dialog" aria-modal="true" aria-label="图片预览">
    <button class="sk-lightbox-close" type="button" aria-label="关闭">×</button>
    <button class="sk-lightbox-prev" type="button" aria-label="上一张">‹</button>
    <img src="" alt="" />
    <button class="sk-lightbox-next" type="button" aria-label="下一张">›</button>
    <div class="sk-lightbox-caption"></div>
  </div>
</SkLayout>

<script is:inline>
  (function () {
    var pool = document.getElementById("sk-pool");
    if (!pool) return;
    var chips = Array.prototype.slice.call(document.querySelectorAll(".sk-chip"));
    var cards = Array.prototype.slice.call(pool.querySelectorAll(".sk-shot-card"));
    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        var f = chip.getAttribute("data-filter");
        chips.forEach(function (c) { c.classList.toggle("is-active", c === chip); });
        cards.forEach(function (card) {
          card.hidden = f !== "all" && card.getAttribute("data-cat") !== f;
        });
      });
    });
  })();
</script>
<script is:inline>
  (function () {
    var box = document.getElementById("sk-lightbox");
    if (!box) return;
    var img = box.querySelector("img");
    var caption = box.querySelector(".sk-lightbox-caption");
    var triggers = Array.prototype.slice.call(document.querySelectorAll("[data-lb]"));
    var current = -1;

    function visible(list) {
      return list.filter(function (t) { return t.offsetWidth > 0; });
    }

    function open(trigger) {
      var list = visible(triggers);
      current = list.indexOf(trigger);
      show(trigger.getAttribute("data-lb"), trigger.getAttribute("data-lb-caption"));
      box.classList.add("open");
    }

    function show(src, text) {
      img.src = src;
      img.alt = text || "";
      caption.textContent = text || "";
    }

    function step(dir) {
      var list = visible(triggers);
      if (!list.length) return;
      current = (current + dir + list.length) % list.length;
      var t = list[current];
      show(t.getAttribute("data-lb"), t.getAttribute("data-lb-caption"));
    }

    function close() {
      box.classList.remove("open");
      img.src = "";
    }

    triggers.forEach(function (t) {
      t.addEventListener("click", function () { open(t); });
    });
    box.querySelector(".sk-lightbox-close").addEventListener("click", close);
    box.querySelector(".sk-lightbox-prev").addEventListener("click", function () { step(-1); });
    box.querySelector(".sk-lightbox-next").addEventListener("click", function () { step(1); });
    box.addEventListener("click", function (e) {
      if (e.target === box) close();
    });
    document.addEventListener("keydown", function (e) {
      if (!box.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });
  })();
</script>
